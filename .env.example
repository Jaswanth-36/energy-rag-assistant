# All optional. Without these the app runs fully offline with TF-IDF and extractive answers.

# Neural embeddings (needs: pip install -r requirements-dense.txt; downloads a small model once)
EMBEDDING_BACKEND=hybrid
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DENSE_WEIGHT=0.5
DENSE_FLOOR=0.5

# LLM-written answers (always verified by the hallucination guard)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-5-5
